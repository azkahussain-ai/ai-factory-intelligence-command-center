__pycache__/
*.pyc
.pytest_cache/
.env
venv/
.venv/

# Raw synthetic data is regenerated by src/run_stage1.py and not read by
# the deployed app - safe to exclude. Everything under data/processed/,
# models/, reports/, and knowledge_base/ IS read directly by app.py at
# runtime (trained models, engineered features, Stage II-IV reports, the
# RAG index) and must stay committed for Hugging Face Spaces deployment -
# there is no training step at deploy time.
data/raw/*
!data/raw/.gitkeep

# Runtime-generated, user/session-specific - safe to exclude and regenerate.
mlruns/
mlflow.db
reports/hitl_audit_log.jsonl
reports/xai/uploaded_image_gradcam_overlay.png
